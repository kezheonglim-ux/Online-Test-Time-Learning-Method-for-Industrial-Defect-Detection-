                },
                "height": 47,
                "name": "PythonScript",
                "node_enable": true,
                "python_code": "# ============================================================\n# Python2 - Parse CTTA Flask Prediction Result + UI Display\n# ============================================================\n# Purpose:\n# 1. Receive prediction result from RestPutJson\n# 2. Extract useful information:\n#    - current image progress\n#    - file name\n#    - category\n#    - anomaly / normal result\n#    - anomaly score\n#    - threshold\n# 3. Prepare display_text for Text block\n# 4. Prepare led_color for LED block\n# 5. Load actual image object for UI Image block\n#\n# Output:\n# - display_text : used by Text block through Set(text_me)\n# - led_color    : used by LED block through Set(led_me)\n# - image        : used by UI Image block through Set(image_status)\n# ============================================================\n\nimport cv2\nimport os\n\n\n# ------------------------------------------------------------\n# 1. Keep original incoming payload\n# ------------------------------------------------------------\n# RestPutJson may return the Flask result together with the\n# original Python1 payload.\n#\n# Python1 provides:\n# - index\n# - total\n# - image_path\n# - category\n#\n# RestPutJson / Flask provides:\n# - label\n# - is_anomaly\n# - anomaly_score\n# - threshold\n# ------------------------------------------------------------\n\nroot_payload = payload\nres = payload\n\n\n# ------------------------------------------------------------\n# 2. Unwrap payload if CiRA wraps it inside \"payload\"\n# ------------------------------------------------------------\n\nif isinstance(root_payload, dict) and \"payload\" in root_payload and isinstance(root_payload[\"payload\"], dict):\n\troot_payload = root_payload[\"payload\"]\n\n\n# ------------------------------------------------------------\n# 3. Extract progress information from Python1 payload\n# ------------------------------------------------------------\n# Python1 should output:\n# {\n#   \"index\": 3,\n#   \"total\": 18,\n#   \"image_path\": \"...\",\n#   \"category\": \"tile\"\n# }\n#\n# If index / total cannot be found, use \"-\".\n# ------------------------------------------------------------\n\nimage_index = \"-\"\nimage_total = \"-\"\n\nif isinstance(root_payload, dict):\n\timage_index = root_payload.get(\"index\", \"-\")\n\timage_total = root_payload.get(\"total\", \"-\")\n\n\n# ------------------------------------------------------------\n# 4. Extract Flask result from RestPutJson\n# ------------------------------------------------------------\n# RestPutJson usually stores the response under:\n# {\n#   \"RestPutJson\": {\n#       \"status\": \"OK\",\n#       \"label\": \"anomaly\",\n#       \"category\": \"tile\",\n#       ...\n#   }\n# }\n# ------------------------------------------------------------\n\nif isinstance(root_payload, dict) and \"RestPutJson\" in root_payload and isinstance(root_payload[\"RestPutJson\"], dict):\n\tres = root_payload[\"RestPutJson\"]\nelse:\n\tres = root_payload\n\n\n# ------------------------------------------------------------\n# 5. Extract basic prediction information\n# ------------------------------------------------------------\n\nstatus = \"UNKNOWN\"\nfile_name = \"unknown\"\ncategory = \"unknown\"\nimage_path = \"\"\nlabel = \"unknown\"\n\nif isinstance(res, dict):\n\tstatus = res.get(\"status\", \"UNKNOWN\")\n\tfile_name = res.get(\"file_name\", \"unknown\")\n\tcategory = res.get(\"category\", \"unknown\")\n\timage_path = res.get(\"image_path\", \"\")\n\n\t# Flask may return either \"label\" or \"prediction\"\n\tlabel = res.get(\"label\", res.get(\"prediction\", \"unknown\"))\n\n\n# ------------------------------------------------------------\n# 6. Backup extraction from root payload\n# ------------------------------------------------------------\n# Sometimes image_path / category / index / total may stay in\n# root_payload instead of RestPutJson response.\n# ------------------------------------------------------------\n\nif isinstance(root_payload, dict):\n\tif image_path == \"\":\n\t\timage_path = root_payload.get(\"image_path\", \"\")\n\n\tif category == \"unknown\":\n\t\tcategory = root_payload.get(\"category\", \"unknown\")\n\n\tif image_index == \"-\":\n\t\timage_index = root_payload.get(\"index\", \"-\")\n\n\tif image_total == \"-\":\n\t\timage_total = root_payload.get(\"total\", \"-\")\n\n\n# ------------------------------------------------------------\n# 7. Extract anomaly score and threshold safely\n# ------------------------------------------------------------\n\ntry:\n\tscore = float(res.get(\"anomaly_score\", 0))\nexcept:\n\tscore = 0.0\n\ntry:\n\tthreshold = float(res.get(\"threshold\", res.get(\"anomaly_threshold\", 0)))\nexcept:\n\tthreshold = 0.0\n\n\n# ------------------------------------------------------------\n# 8. Decide anomaly status\n# ------------------------------------------------------------\n# Priority:\n# 1. Use \"is_anomaly\" from Flask result\n# 2. If missing, use label:\n#    - anomaly = True\n#    - normal  = False\n# ------------------------------------------------------------\n\nis_anomaly = None\n\nif isinstance(res, dict):\n\tis_anomaly = res.get(\"is_anomaly\", None)\n\nif is_anomaly is None:\n\tif str(label).lower() == \"anomaly\":\n\t\tis_anomaly = True\n\telif str(label).lower() == \"normal\":\n\t\tis_anomaly = False\n\telse:\n\t\tis_anomaly = False\n\n\n# ------------------------------------------------------------\n# 9. Decide LED colour\n# ------------------------------------------------------------\n# CiRA LED uses string colour:\n# - red   = anomaly\n# - green = normal\n# - gray  = error / unknown\n# ------------------------------------------------------------\n\nif status != \"OK\":\n\tled_color = \"gray\"\n\tled_status_text = \"GRAY - ERROR / UNKNOWN\"\nelse:\n\tif is_anomaly:\n\t\tled_color = \"red\"\n\t\tled_status_text = \"RED - ANOMALY\"\n\telse:\n\t\tled_color = \"green\"\n\t\tled_status_text = \"GREEN - NORMAL\"\n\n\n# ------------------------------------------------------------\n# 10. Prepare display text for Text block\n# ------------------------------------------------------------\n# This is the text that will appear in your result panel.\n#\n# Required display format:\n# Progress   : 3 / 18\n# Category   : tile\n# Result     : anomaly\n# Is Anomaly : True\n# File       : bad_2.png\n# Score      : 0.3803\n# Threshold  : 0.0165\n# ------------------------------------------------------------\n\ndisplay_text = (\n\t\"CTTA ANOMALY DETECTION RESULT\\n\"\n\t\"------------------------------\\n\"\n\t\"Progress   : {} / {}\\n\"\n\t\"Category   : {}\\n\"\n\t\"Result     : {}\\n\"\n\t\"Is Anomaly : {}\\n\"\n\t\"File       : {}\\n\"\n\t\"Score      : {:.4f}\\n\"\n\t\"Threshold  : {:.4f}\\n\"\n).format(\n\timage_index,\n\timage_total,\n\tcategory,\n\tlabel,\n\tis_anomaly,\n\tfile_name,\n\tscore,\n\tthreshold\n)\n\n\n# ------------------------------------------------------------\n# 11. Load actual image object for UI Image block\n# ------------------------------------------------------------\n# UI Image cannot display only image_path text.\n# It needs the actual image object loaded by cv2.imread().\n#\n# Your UI Image setup:\n# - Set block name: image_status\n# - UI Image Flow data: image_status\n# ------------------------------------------------------------\n\nimg = None\n\ntry:\n\tif image_path:\n\t\t# Convert slash style for Windows cv2 reading\n\t\timage_path_for_cv2 = image_path.replace(\"/\", \"\\\\\")\n\n\t\t# Try Windows-style path first\n\t\tif os.path.exists(image_path_for_cv2):\n\t\t\timg = cv2.imread(image_path_for_cv2)\n\n\t\t# Backup: try original path\n\t\tif img is None and os.path.exists(image_path):\n\t\t\timg = cv2.imread(image_path)\n\nexcept Exception as e:\n\timg = None\n\n\n# ------------------------------------------------------------\n# 12. Prepare final output payload\n# ------------------------------------------------------------\n# display_text is used by Text block:\n# - Set block name: text_me\n# - Text Flow data: text_me\n#\n# led_color is used by LED block:\n# - Set block name: led_me\n# - LED Flow data: led_me\n#\n# image is used by UI Image block:\n# - Set block name: image_status\n# - UI Image Flow data: image_status\n# ------------------------------------------------------------\n\nout = {\n\t\"display_text\": display_text,\n\t\"led_color\": led_color,\n\t\"led_status_text\": led_status_text,\n\n\t\"image_index\": image_index,\n\t\"image_total\": image_total,\n\t\"file_name\": file_name,\n\t\"category\": category,\n\t\"label\": label,\n\t\"is_anomaly\": is_anomaly,\n\t\"score\": score,\n\t\"threshold\": threshold,\n\t\"image_path\": image_path,\n\t\"image_loaded\": img is not None,\n\n\t# Keep raw response for debugging\n\t\"raw_response\": res\n}\n\n\n# ------------------------------------------------------------\n# 13. Return output to CiRA\n# ------------------------------------------------------------\n\npayload = out\noutput = out\nresult = out\n\n\n# ------------------------------------------------------------\n# 14. Send actual image object to CiRA UI Image block\n# ------------------------------------------------------------\n\nimage = img",
